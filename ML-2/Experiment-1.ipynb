   "source": [
    "import pandas as pd\n",
    "\n",
    "d=pd.read_csv(\"enjoysport.csv\")\n",
    "X=d.iloc[:,:-1].values\n",
    "Y=d.iloc[:,-1].values\n",
    "\n",
    "h=list(X[0])\n",
    "for i in range(len(X)):\n",
    "    if Y[i]==\"yes\":\n",
    "        for j in range(len(h)):\n",
    "            if h[j]!=X[i][j]: \n",
    "                h[j]=\"?\"\n",
    "\n",
    "print(\"Final Hypothesis:\",h)"
   ]
